POSTGRES_USER=nursing
POSTGRES_PASSWORD=change-me-to-a-strong-db-password
POSTGRES_DB=nursing

# 容器内主机名是 db；同机 Docker 网络一般无需 sslmode=require
DATABASE_URL=postgresql://nursing:change-me-to-a-strong-db-password@db:5432/nursing?schema=public

NEXT_PUBLIC_APP_URL=https://ininurse.cn
AUTH_SECRET=change-me-to-a-long-random-string
READ_THRESHOLD_MS=8000
USE_PGLITE=0

STAFF_PASSWORD_ADMIN=admin
STAFF_PASSWORD_HEAD=set-head-password
STAFF_PASSWORD_LI=set-li-password
STAFF_PASSWORD_WANG=set-wang-password
STAFF_PASSWORD_ZHAO=set-zhao-password
STAFF_PASSWORD_QIAN=set-qian-password
STAFF_PASSWORD_NURSING=set-nursing-password
STAFF_PASSWORD_QA=set-qa-password
